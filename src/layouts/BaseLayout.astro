---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import { FOOTER_QUICK_LINKS } from "../config/navigation";
import { siteData } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = siteData.name, description = siteData.tagline } = Astro.props;
const year = new Date().getFullYear();
const canonicalUrl = "https://henrymusasizi.ug";
const ogImage = `${canonicalUrl}/images/Hon_Musasiizi.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/images/Hon_Musasiizi.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/images/Hon_Musasiizi.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteData.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data: Person -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Hon. Henry Ariganyira Musasizi",
      "jobTitle": "Minister of Finance, Planning and Economic Development",
      "description": "Ugandan politician, certified public accountant, and Minister of Finance, Planning and Economic Development. MP for Rubanda East since 2011.",
      "url": {canonicalUrl},
      "image": {ogImage}
    }
    </script>
  </head>
  <body class="page-fade-in">
    <slot name="navbar">
      <Navbar />
    </slot>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer__grid">
        <div class="footer__brand">
          <p class="footer__brand-name">Hon. Henry Musasizi</p>
          <div class="footer__contact">
            <p>{siteData.addressLines[0]}</p>
            <p>{siteData.addressLines[1]}</p>
            <p>{siteData.addressLines[2]}</p>
            <p>
              <a href={`mailto:${siteData.email}`}>{siteData.email}</a>
            </p>
          </div>
          <div class="footer__social">
            <a href={`https://x.com/${siteData.xHandle}`} aria-label="X / Twitter" target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a href={`mailto:${siteData.email}`} aria-label="Email">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </a>
          </div>
        </div>
        <div>
          <p class="footer__heading">Quick Links</p>
          <ul class="footer__links">
            {
              FOOTER_QUICK_LINKS.map(({ href, label }) => (
                <li><a href={href}>{label}</a></li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="footer__heading">Constituency</p>
          <ul class="footer__links">
<!--             <li><a href="/projects">Development Projects</a></li> -->
            <li><a href="/gallery">Photo Gallery</a></li>
            <li><a href="/contact">Contact Office</a></li>
          </ul>
          <p class="footer__heading">Resources</p>
          <ul class="footer__links">
            <li><a href="/speeches">Speeches & Statements</a></li>
            <li><a href="/blog">News & Updates</a></li>
            <li><a href="/about">Full Biography</a></li>
          </ul>
        </div>
      </div>
      <div class="footer__bottom">
        <span>&copy; {year} Hon. Henry Musasizi. All rights reserved.</span>
        <span>Minister of Finance, Planning &amp; Economic Development</span>
      </div>
    </footer>
  </body>
</html>

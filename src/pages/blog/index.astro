---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { siteData } from "../../data/site";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const categories = ["All", "Speeches", "Policy", "Economic Updates", "Constituency Projects"];
---

<BaseLayout title={`News | ${siteData.name}`} description="Latest news, policy updates, and announcements.">
  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="News"
        title="Blog & Updates"
        description="Latest news articles, policy analysis, and announcements."
      />

      <div style="display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-6);">
        {categories.map((cat) => (
          <a href={`#${cat.toLowerCase().replace(" ", "-")}`} class="btn btn--ghost" style="font-size: var(--text-xs);">
            {cat}
          </a>
        ))}
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-5); margin-top: var(--space-8);">
        {posts.map((post) => (
          <article class="card" style="display: flex; flex-direction: column;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span class="date-badge">{post.data.date.toLocaleDateString("en-UG")}</span>
              <span style="font-size: var(--text-xs); font-weight: 600; color: var(--color-accent);">{post.data.category}</span>
            </div>
            <h3 style="font-size: var(--text-lg); font-weight: 500; margin-top: var(--space-3);">{post.data.title}</h3>
            {post.data.excerpt && (
              <p style="font-size: var(--text-sm); color: var(--color-muted); margin-top: var(--space-2);">{post.data.excerpt}</p>
            )}
            <div style="margin-top: auto; display: flex; align-items: center; gap: var(--space-4); padding-top: var(--space-5);">
              <a href={`/blog/${post.slug}/`} style="font-size: var(--text-sm); font-weight: 600;">
                Read full story →
              </a>
              <div style="display: flex; gap: var(--space-2); margin-left: auto;">
                <a href={`https://x.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=https://henrymusasizi.ug/blog/${post.slug}/`} target="_blank" rel="noopener noreferrer" style="font-size: var(--text-xs); color: var(--color-muted);">X</a>
                <a href={`https://www.linkedin.com/shareArticle?mini=true&url=https://henrymusasizi.ug/blog/${post.slug}/`} target="_blank" rel="noopener noreferrer" style="font-size: var(--text-xs); color: var(--color-muted);">LinkedIn</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

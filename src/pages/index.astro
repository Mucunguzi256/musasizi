---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { siteData } from "../data/site";

const speeches = (await getCollection("speeches")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const recentSpeeches = speeches.slice(0, 3);

const projects = await getCollection("projects");
const ongoingProjects = projects.filter((p) => p.data.status !== "Completed").slice(0, 3);

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout title={`${siteData.name} — Official Portfolio`} description={siteData.tagline}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__grid">
      <div class="hero__content animate-fade-in">
        <span class="hero__role">Official Portfolio</span>
        <h1 class="hero__name">{siteData.name}</h1>
        <p class="hero__title">{siteData.title}</p>
        <p class="hero__motto">"{siteData.tagline}"</p>
        <div class="hero__actions">
          <a href="/about" class="btn btn--primary">
            Full Biography
          </a>
          <a href="/speeches" class="btn btn--outline">
            Speeches & Statements
          </a>
        </div>
      </div>

      <div class="hero__portrait-wrapper animate-fade-in delay-200">
        <div class="hero__crest" aria-hidden="true">
          <!-- Uganda Coat of Arms SVG watermark -->
          <svg viewBox="0 0 500 500" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M250 30L310 120H190L250 30Z" />
            <path d="M250 60L180 170H320L250 60Z" />
            <path d="M150 200L250 350L350 200H150Z" />
            <path d="M120 250L250 430L380 250H120Z" />
            <circle cx="250" cy="260" r="60" />
            <path d="M200 260L235 290L300 240" stroke="currentColor" stroke-width="8" fill="none" />
          </svg>
        </div>
        <img
          src="/images/Hon_Musasiizi.png"
          alt={siteData.name}
          class="hero__portrait"
          width="420"
          height="420"
          style="aspect-ratio: 1; object-fit: cover;"
        />
        <div class="hero__titles" id="hero-titles">
          <span class="hero__title-line" data-text="Minister of Finance, Planning &amp; Economic Development"></span>
          <span class="hero__title-line" data-text="MP Rubanda East"></span>
          <span class="hero__title-line" data-text="NRM Chairperson, Rubanda District"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <div class="stats-bar">
    <div class="stat-item animate-fade-in delay-100">
      <p class="stat-item__number">2011</p>
      <p class="stat-item__label">MP Rubanda East</p>
    </div>
    <div class="stat-item animate-fade-in delay-200">
      <p class="stat-item__number">4</p>
      <p class="stat-item__label">Terms Served</p>
    </div>
    <div class="stat-item animate-fade-in delay-300">
      <p class="stat-item__number">2021</p>
      <p class="stat-item__label">Appointed Minister</p>
    </div>
<!--     <div class="stat-item animate-fade-in delay-400">
      <p class="stat-item__number">15+</p>
      <p class="stat-item__label">Development Projects</p>
    </div> -->
  </div>

  <!-- About Snap + Quick Links (Bento) -->
  <section class="section">
    <div style="display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--space-6); max-width: var(--container); margin: 0 auto; padding: 0 var(--space-6);">
      <div class="card animate-fade-in" style="grid-column: span 12; --delay: 0.1s;">
        <span class="section-label">About</span>
        <h2 style="font-size: var(--text-3xl); font-weight: 500; margin-top: var(--space-2);">Public Service &amp; Leadership</h2>
        <div class="accent-divider"></div>
        <p style="font-size: var(--text-base); color: var(--color-muted); max-width: 640px; line-height: var(--leading-relaxed);">
          Hon. Henry Ariganyira Musasizi is a Ugandan politician, certified public accountant, and MBA graduate serving as Minister of Finance, Planning and Economic Development. He has represented Rubanda East Constituency since 2011.
        </p>
        <div style="margin-top: var(--space-4);">
          <a href="/about" class="btn btn--outline">Read Full Biography</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Speech -->
  {recentSpeeches.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionTitle eyebrow="Latest" title="Recent Speeches" description="Official remarks and policy statements." />
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-6);">
          {recentSpeeches.map((speech) => (
            <article class="card animate-fade-in">
              <span class="date-badge">{speech.data.date.toLocaleDateString("en-UG")}</span>
              <h3 style="font-size: var(--text-lg); margin-top: var(--space-3);">{speech.data.title}</h3>
              <p style="font-size: var(--text-sm); color: var(--color-muted); margin-top: var(--space-1);">{speech.data.location ?? "Uganda"}</p>
              <a href={`/speeches/${speech.slug}/`} style="display: inline-block; margin-top: var(--space-4); font-size: var(--text-sm); font-weight: 600;">
                Read full text →
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

<!--   &lt;!&ndash; Development Projects &ndash;&gt;
  {ongoingProjects.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionTitle eyebrow="Delivery" title="Development Projects" description="Tracking progress across Uganda." />
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-6);">
          {ongoingProjects.map((project) => (
            <article class="card animate-fade-in">
              <span class="date-badge">{project.data.district}</span>
              <h3 style="font-size: var(--text-lg); margin-top: var(--space-3);">{project.data.title}</h3>
              <p style="font-size: var(--text-sm); color: var(--color-muted); margin-top: var(--space-2);">Status: {project.data.status}</p>
              <a href={`/projects/${project.slug}/`} style="display: inline-block; margin-top: var(--space-4); font-size: var(--text-sm); font-weight: 600;">
                Project details →
              </a>
            </article>
          ))}
        </div>
        <div style="text-align: center; margin-top: var(--space-8);">
          <a href="/projects" class="btn btn--outline">View All Projects</a>
        </div>
      </div>
    </section>
  )} -->

  <!-- Latest News -->
  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionTitle eyebrow="News" title="Latest Updates" description="News, policy analysis, and announcements." />
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-6);">
          {posts.map((post) => (
            <article class="card animate-fade-in">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <span class="date-badge">{post.data.date.toLocaleDateString("en-UG")}</span>
                <span style="font-size: var(--text-xs); font-weight: 600; color: var(--color-accent);">{post.data.category}</span>
              </div>
              <h3 style="font-size: var(--text-lg); margin-top: var(--space-3);">{post.data.title}</h3>
              {post.data.excerpt && (
                <p style="font-size: var(--text-sm); color: var(--color-muted); margin-top: var(--space-2);">{post.data.excerpt}</p>
              )}
              <a href={`/blog/${post.slug}/`} style="display: inline-block; margin-top: var(--space-4); font-size: var(--text-sm); font-weight: 600;">
                Read full story →
              </a>
            </article>
          ))}
        </div>
        <div style="text-align: center; margin-top: var(--space-8);">
          <a href="/blog" class="btn btn--outline">All News</a>
        </div>
      </div>
    </section>
  )}

  <!-- Contact CTA -->
  <section class="section">
    <div class="container--narrow" style="max-width: var(--container-narrow); margin: 0 auto; padding: var(--space-6); text-align: center;">
      <span class="section-label">Reach Out</span>
      <h2 style="font-size: var(--text-3xl); font-weight: 500; margin-top: var(--space-2);">Get in Touch</h2>
      <div class="accent-divider" style="margin: var(--space-3) auto var(--space-6);"></div>
      <p style="color: var(--color-muted); margin-bottom: var(--space-6);">
        Contact the Minister's office for constituency services, media inquiries, or policy matters.
      </p>
      <a href="/contact" class="btn btn--primary">Contact Office</a>
    </div>
  </section>
</BaseLayout>

<script>
  (function () {
    var container = document.getElementById("hero-titles");
    if (!container) return;

    var lines = container.querySelectorAll(".hero__title-line");
    if (!lines.length) return;

    var texts = Array.from(lines).map(function (el) { return el.dataset.text || ""; });
    var phase = 0; // 0=typing line1, 1=typing line2, 2=typing line3, 3=pause, 4=deleting all
    var charIndex = 0;
    var deletingLine = 2; // delete from bottom up

    function tick() {
      // --- TYPING PHASES ---
      if (phase < 3) {
        var el = lines[phase];
        var full = texts[phase];
        if (charIndex === 0) el.classList.add("typing");

        charIndex++;
        el.textContent = full.slice(0, charIndex);

        if (charIndex >= full.length) {
          el.classList.remove("typing");
          charIndex = 0;
          phase++;
          if (phase === 3) {
            // All three typed — pause then delete
            setTimeout(tick, 3000);
            return;
          }
        }

        var speed = 50 + Math.random() * 40;
        setTimeout(tick, speed);
        return;
      }

      // --- PAUSE PHASE (handled above with setTimeout) ---

      // --- DELETING PHASE ---
      if (phase === 3) {
        // Start deleting from bottom line
        deletingLine = 2;
        lines[deletingLine].classList.add("typing");
        phase = 4;
      }

      if (phase === 4) {
        var el = lines[deletingLine];
        var full = texts[deletingLine];
        var current = el.textContent.length;

        if (current > 0) {
          el.textContent = full.slice(0, current - 1);
          setTimeout(tick, 15);
          return;
        }

        // This line fully deleted
        el.classList.remove("typing");
        deletingLine--;

        if (deletingLine < 0) {
          // All lines deleted — restart
          lines.forEach(function (l) { l.textContent = ""; });
          phase = 0;
          charIndex = 0;
          setTimeout(tick, 300);
          return;
        }

        lines[deletingLine].classList.add("typing");
        setTimeout(tick, 10);
        return;
      }
    }

    // Start after page load delay
    setTimeout(tick, 800);
  })();
</script>

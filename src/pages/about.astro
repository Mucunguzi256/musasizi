---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteData } from "../data/site";

const keyRoles = [
  {
    title: "Minister of State for Finance",
    subtitle: "General Duties",
    period: "2021 — Present",
    description: "Appointed by H.E. Yoweri Museveni to oversee financial management, budgeting, and economic policy coordination.",
  },
  {
    title: "Member of Parliament",
    subtitle: "Rubanda East Constituency",
    period: "2011 — Present",
    description: "Democratically elected to represent the people of Rubanda East in the Parliament of Uganda for four consecutive terms.",
  },
  {
    title: "Chairperson",
    subtitle: "Committee on Finance, Planning & Economic Development",
    period: "2016 — 2021",
    description: "Led parliamentary oversight of Uganda's budget, fiscal policy, and economic development programs.",
  },
];

const timeline = [
  { year: "2006", event: "Accountant, CARITAS Kabale Diocese" },
  { year: "2007", event: "Project Accountant, AMREF Uganda" },
  { year: "2009", event: "Regional Accountant, AMREF Uganda" },
  { year: "2011", event: "Elected MP, Rubanda East — First Term" },
  { year: "2012", event: "Partner, AHMHE Associates (Certified Public Accountants)" },
  { year: "2015", event: "Re-elected MP, Rubanda East — Second Term" },
  { year: "2016", event: "Appointed Chairperson, Finance Committee" },
  { year: "2020", event: "Re-elected MP, Rubanda East — Third Term" },
  { year: "2021", event: "Appointed Minister of State for Finance (General Duties)" },
  { year: "2025", event: "Re-elected MP, Rubanda East — Fourth Term" },
];

const education = [
  {
    degree: "MBA",
    school: "Heriot-Watt University (Edinburgh Business School)",
  },
  {
    degree: "Bachelor of Commerce (Accounting)",
    school: "Makerere University — Second Class Upper",
  },
  {
    degree: "Certified Public Accountant",
    school: "Institute of Certified Public Accountants of Uganda (ICPAU)",
  },
];
---

<BaseLayout title={`About | ${siteData.name}`} description={`Biography and public service overview for ${siteData.name}, Minister of State for Finance and MP for Rubanda East.`}>
  <!-- Hero -->
  <section class="hero" style="padding-bottom: var(--space-8);">
    <div class="hero__grid">
      <div class="hero__portrait-wrapper animate-fade-in">
        <img
          src="/images/Hon_Musasiizi.png"
          alt={siteData.name}
          class="hero__portrait"
          width="420"
          height="420"
          style="aspect-ratio: 1; object-fit: cover;"
        />
      </div>
      <div class="hero__content animate-fade-in delay-200">
        <span class="section-label">Profile</span>
        <h1 class="hero__name" style="font-size: var(--text-5xl);">About {siteData.name}</h1>
        <div class="accent-divider"></div>
        <p style="color: var(--color-muted); max-width: 520px;">
          Born 25 February 1981 in Rubanda, Kabale District. CPA turned politician driving Uganda's economic transformation. MP for Rubanda East since 2011.
        </p>
        <p style="color: var(--color-muted); max-width: 520px;">
          Appointed State Minister for Finance (General Duties) by H.E. Yoweri Museveni in June 2021. Former Chairperson of the Committee on Finance, Planning & Economic Development (2016–2021).
        </p>
      </div>
    </div>
  </section>

  <!-- Full Biography -->
  <section class="section">
    <div class="container--narrow" style="max-width: var(--container-narrow); margin: 0 auto; padding: 0 var(--space-6);">
      <span class="section-label">Biography</span>
      <h2 style="font-size: var(--text-3xl); font-weight: 500; margin-top: var(--space-1);">Public Service &amp; Leadership Journey</h2>
      <div class="accent-divider"></div>
      <div class="prose">
        <p>Hon. Henry Ariganyira Musasizi (born 25 February 1981) is a distinguished Ugandan politician, certified public accountant, and business administrator. He has represented Rubanda East Constituency in the Parliament of Uganda since 2011 and currently serves as Minister of State for Finance, Planning and Economic Development (General Duties), a position he has held since 2021.</p>

        <p>Before entering politics, Henry built a career in finance and accounting. He was a Partner at AHMHE Associates, Certified Public Accountants (2012–2015), and held roles at AMREF Uganda as Regional Accountant (2009–2010) and Project Accountant (2007–2009). He began his professional career as an Accountant at CARITAS Kabale Diocese (2006–2007).</p>

        <p>In Parliament, he has chaired the Committee on Finance, Planning and Economic Development (2016–2021), served on the Budget Committee, the Public Accounts Committee (Central Government), and the Presidential Advisory Committee on Budget. He is a long-standing member of the Institute of Certified Public Accountants of Uganda.</p>

        <p>Beyond formal roles, he has served as Chairman of the Kabale District Roads Committee, Vice Chairman of the Uganda Parliamentary Forum on Youth Affairs, Treasurer of the Kabale Parliamentary Forum, and Member of the Kigezi Parliamentary Forum.</p>

        <p>He holds an MBA from Heriot-Watt University (Edinburgh Business School) and a Bachelor of Commerce (Accounting, Second Class Upper) from Makerere University.</p>
      </div>
    </div>
  </section>

  <!-- Key Roles -->
  <section class="section">
    <div class="container">
      <span class="section-label">Positions</span>
      <h2 style="font-size: var(--text-3xl); font-weight: 500; margin-top: var(--space-1);">Key Roles</h2>
      <div class="accent-divider"></div>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-6); margin-top: var(--space-6);">
        {keyRoles.map((role) => (
          <article class="card" style="display: flex; flex-direction: column; gap: var(--space-2);">
            <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: var(--color-accent-subtle); border-radius: var(--radius-sm); color: var(--color-accent); margin-bottom: var(--space-2);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                <path d="M2 17l10 5 10-5"/>
                <path d="M2 12l10 5 10-5"/>
              </svg>
            </div>
            <h3 style="font-size: var(--text-lg); font-weight: 500;">{role.title}</h3>
            <p style="font-size: var(--text-sm); color: var(--color-muted);">{role.subtitle}</p>
            <p style="font-size: var(--text-xs); color: var(--color-accent); font-weight: 600; letter-spacing: var(--tracking-wide); text-transform: uppercase;">{role.period}</p>
            <p style="font-size: var(--text-sm); color: var(--color-muted); line-height: var(--leading);">{role.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section">
    <div class="container--narrow" style="max-width: var(--container-narrow); margin: 0 auto; padding: 0 var(--space-6);">
      <span class="section-label">History</span>
      <h2 style="font-size: var(--text-3xl); font-weight: 500; margin-top: var(--space-1);">Career Timeline</h2>
      <div class="accent-divider"></div>
      <div style="position: relative; margin-top: var(--space-8); padding-left: var(--space-8);">
        <!-- Vertical line -->
        <div style="position: absolute; left: 8px; top: 0; bottom: 0; width: 2px; background: var(--color-border);"></div>
        {timeline.map((entry) => (
          <div style="position: relative; padding-bottom: var(--space-6);">
            {/* Dot */}
            <div style="position: absolute; left: calc(-1 * var(--space-8) + 3px); top: 4px; width: 12px; height: 12px; border-radius: 50%; background: var(--color-accent); border: 2px solid var(--color-surface);"></div>
            <span style="font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; color: var(--color-accent);">{entry.year}</span>
            <p style="font-size: var(--text-base); color: var(--color-text); margin-top: var(--space-1);">{entry.event}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Education -->
  <section class="section">
    <div class="container--narrow" style="max-width: var(--container-narrow); margin: 0 auto; padding: 0 var(--space-6);">
      <span class="section-label">Education</span>
      <h2 style="font-size: var(--text-3xl); font-weight: 500; margin-top: var(--space-1);">Academic &amp; Professional</h2>
      <div class="accent-divider"></div>
      <div style="display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-6);">
        {education.map((edu) => (
          <div class="card" style="display: flex; align-items: center; gap: var(--space-4);">
            <div style="flex-shrink: 0; width: 48px; height: 48px; background: var(--color-accent-subtle); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; color: var(--color-accent);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                <path d="M6 12v5c3 3 9 3 12 0v-5"/>
              </svg>
            </div>
            <div>
              <p style="font-weight: 600;">{edu.degree}</p>
              <p style="font-size: var(--text-sm); color: var(--color-muted);">{edu.school}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionTitle from "../../components/SectionTitle.astro";

const projects = await getCollection("projects");
---

<BaseLayout title="Development Projects | Hon. Henry Musasizi" description="Tracking implementation progress of priority development projects across Uganda.">
  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Delivery"
        title="Development Projects"
        description="Tracking implementation progress of priority projects across Uganda."
      />
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-5);">
        {projects.map((project) => (
          <article class="card" style="display: flex; flex-direction: column;">
            <span class="date-badge">{project.data.district}</span>
            <h3 style="font-size: var(--text-lg); font-weight: 500; margin-top: var(--space-3);">{project.data.title}</h3>
            <p style="font-size: var(--text-sm); color: var(--color-muted); margin-top: var(--space-2);">
              Status: {project.data.status}
            </p>
            <a href={`/projects/${project.slug}/`} style="margin-top: auto; padding-top: var(--space-5); font-size: var(--text-sm); font-weight: 600;">
              Project details →
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

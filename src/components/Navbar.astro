---
import { NAV_LINKS } from "../config/navigation";
import { siteData } from "../data/site";

const links = NAV_LINKS.flatMap((link) =>
  link.children ? [link, ...link.children] : [link]
);
---

<header class="navbar" id="navbar">
  <div class="navbar__inner">
    <a href="/" class="navbar__brand">
      <img src="/images/Hon_Musasiizi.png" alt="" class="navbar__logo" width="36" height="36" />
      <div>
        <span class="navbar__brand-text">Hon. Musasizi</span>
        <span class="navbar__brand-sub">Minister of Finance, Planning &amp; Economic Development</span>
      </div>
    </a>

    <nav aria-label="Primary" class="navbar__links">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={{
            navbar__cta: label === "Contact",
          }}
        >
          {label}
        </a>
      ))}
    </nav>

    <button
      type="button"
      class="navbar__toggle"
      id="nav-toggle"
      aria-controls="nav-mobile"
      aria-expanded="false"
      aria-label="Toggle menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="navbar__mobile" id="nav-mobile">
    {links.map(({ href, label }) => (
      <a href={href}>{label}</a>
    ))}
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("nav-mobile");

  if (toggle && panel) {
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      panel.classList.toggle("open", !expanded);
      document.body.style.overflow = expanded ? "" : "hidden";
    });

    // Close on link click
    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        toggle.setAttribute("aria-expanded", "false");
        panel.classList.remove("open");
        document.body.style.overflow = "";
      });
    });
  }
</script>

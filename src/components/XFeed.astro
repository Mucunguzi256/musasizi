---
// X Feed - Reliable embed using Twitter's oEmbed endpoint
// Falls back gracefully to a manual link card if the embed fails
import { siteData } from "../data/site";
const xUrl = `https://x.com/${siteData.xHandle}`;
---

<div class="x-feed" id="x-feed">
  <div class="x-feed__embed">
    <blockquote class="twitter-tweet" data-theme="light" data-width="100%">
      <p lang="en" dir="ltr">
        <a href={xUrl}>Loading posts from @{siteData.xHandle}...</a>
      </p>
    </blockquote>
  </div>
  <noscript>
    <div class="x-feed__fallback show">
      <p>Follow <a href={xUrl} target="_blank" rel="noopener noreferrer">@{siteData.xHandle}</a> on X for the latest updates, policy statements, and constituency news.</p>
      <a href={xUrl} target="_blank" rel="noopener noreferrer" class="btn btn--outline" style="margin-top: var(--space-4);">
        View on X →
      </a>
    </div>
  </noscript>
</div>

<style>
  .x-feed {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    min-height: 300px;
  }
  .x-feed__embed {
    width: 100%;
  }
  .x-feed .twitter-tweet {
    width: 100% !important;
    margin: 0 !important;
  }
  .x-feed .twitter-tweet > p {
    padding: var(--space-8);
    text-align: center;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .x-feed .twitter-tweet iframe {
    width: 100% !important;
  }
  .x-feed__fallback {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-8);
    min-height: 200px;
  }
  .x-feed__fallback p {
    color: var(--color-muted);
    font-size: var(--text-sm);
    max-width: 360px;
    line-height: var(--leading-relaxed);
  }
  .x-feed__fallback .btn {
    font-size: var(--text-xs);
    padding: var(--space-2) var(--space-5);
  }
  .x-feed__fallback.show {
    display: flex;
  }
  .x-feed__fallback a {
    color: var(--color-accent);
  }
</style>

<script>
  (function () {
    const container = document.getElementById("x-feed");
    if (!container) return;

    // Load Twitter widget script
    function loadWidget() {
      if (window.twttr?.widgets?.load) {
        window.twttr.widgets.load(container);
        return;
      }
      const s = document.createElement("script");
      s.src = "https://platform.twitter.com/widgets.js";
      s.async = true;
      s.onload = () => {
        if (window.twttr?.widgets?.load) {
          window.twttr.widgets.load(container);
        }
      };
      document.head.appendChild(s);
    }

    loadWidget();

    // Show fallback after timeout if widget doesn't render
    setTimeout(() => {
      const embed = container.querySelector(".x-feed__embed");
      const hasIframe = embed?.querySelector("iframe");
      if (!hasIframe) {
        // Create fallback element dynamically
        const fallback = container.querySelector(".x-feed__fallback");
        if (fallback) {
          fallback.classList.add("show");
        } else {
          embed.innerHTML = `
            <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:2rem;min-height:200px;">
              <p style="color:var(--color-muted);font-size:0.875rem;max-width:360px;line-height:1.6;">
                Follow <a href="${xUrl}" target="_blank" rel="noopener noreferrer" style="color:var(--color-accent);">@${siteData.xHandle}</a> on X for the latest updates, policy statements, and constituency news.
              </p>
              <a href="${xUrl}" target="_blank" rel="noopener noreferrer" class="btn btn--outline" style="margin-top:1rem;font-size:0.75rem;padding:0.5rem 1.25rem;">
                View on X →
              </a>
            </div>`;
        }
      }
    }, 5000);
  })();
</script>
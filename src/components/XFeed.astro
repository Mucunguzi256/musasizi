---
// X / Twitter Timeline Embed
import { siteData } from "../data/site";
const xUrl = `https://x.com/${siteData.xHandle}`;
---

<div class="x-feed">
  <div class="x-feed__embed">
    <a
      class="twitter-timeline"
      data-height="500"
      data-tweet-limit="5"
      data-chrome="noheader nofooter noborders transparent"
      href={xUrl}
    >
      Loading posts from @{siteData.xHandle}...
    </a>
  </div>
  <div class="x-feed__fallback">
    <p>Follow <a href={xUrl} target="_blank" rel="noopener noreferrer">@{siteData.xHandle}</a> on X for the latest updates, policy statements, and constituency news.</p>
    <a href={xUrl} target="_blank" rel="noopener noreferrer" class="btn btn--outline" style="margin-top: var(--space-4);">
      View on X →
    </a>
  </div>
</div>

<style>
  .x-feed {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    min-height: 200px;
  }
  .x-feed__embed {
    width: 100%;
  }
  .x-feed__embed .twitter-timeline {
    width: 100% !important;
  }
  .x-feed__fallback {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-8);
    min-height: 200px;
  }
  .x-feed__fallback p {
    color: var(--color-muted);
    font-size: var(--text-sm);
    max-width: 360px;
    line-height: var(--leading-relaxed);
  }
  .x-feed__fallback .btn {
    font-size: var(--text-xs);
    padding: var(--space-2) var(--space-5);
  }
  .x-feed__fallback.show {
    display: flex;
  }
</style>

<script>
  const el = document.currentScript?.parentElement;
  if (!el) return;

  const embedEl = el.querySelector(".x-feed__embed");
  const fallbackEl = el.querySelector(".x-feed__fallback");

  // If Twitter widget JS hasn't rendered after 3 seconds, show fallback
  const fallbackTimer = setTimeout(() => {
    if (embedEl && embedEl.querySelector("iframe")) return; // widget loaded
    if (embedEl) embedEl.style.display = "none";
    if (fallbackEl) fallbackEl.classList.add("show");
  }, 4000);

  // Load Twitter/X embed script
  if (!document.getElementById("twitter-wjs")) {
    const s = document.createElement("script");
    s.id = "twitter-wjs";
    s.src = "https://platform.twitter.com/widgets.js";
    s.async = true;
    s.onload = () => {
      if (window.twttr?.widgets?.load) {
        window.twttr.widgets.load();
      }
    };
    s.onerror = () => {
      clearTimeout(fallbackTimer);
      if (embedEl) embedEl.style.display = "none";
      if (fallbackEl) fallbackEl.classList.add("show");
    };
    document.head.appendChild(s);
  } else if (window.twttr?.widgets?.load) {
    window.twttr.widgets.load();
  }
</script>